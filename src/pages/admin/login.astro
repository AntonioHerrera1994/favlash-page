---
const error = Astro.url.searchParams.get('error');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión — FavLash Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="login-wrap">
      <form method="POST" action="/api/auth/login" class="login-card">
        <div class="login-brand">
          FavLash <span>Admin</span>
        </div>
        <p class="login-sub">Inicia sesión para gestionar tus citas</p>

        {error && (
          <p class="login-error">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="9" />
              <line x1="12" y1="8" x2="12" y2="13" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            Correo o contraseña incorrectos.
          </p>
        )}

        <label class="login-label">
          Correo
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label class="login-label">
          Contraseña
          <div class="login-password-wrap">
            <input type="password" name="password" id="password-input" required autocomplete="current-password" />
            <button type="button" id="toggle-password" class="login-toggle-eye" aria-label="Mostrar contraseña">
              <svg class="icon-eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12Z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              <svg class="icon-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                <path d="M3 3l18 18" />
                <path d="M10.6 5.1A10.9 10.9 0 0 1 12 5c7 0 10.5 7 10.5 7a13.4 13.4 0 0 1-3.2 4.1M6.3 6.3C3.4 8.1 1.5 12 1.5 12S5 19 12 19a10.6 10.6 0 0 0 4.2-.9" />
                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
              </svg>
            </button>
          </div>
        </label>

        <button type="submit" class="login-btn">Entrar</button>
      </form>
    </main>

    <script>
      const input = document.getElementById('password-input') as HTMLInputElement;
      const toggleBtn = document.getElementById('toggle-password') as HTMLButtonElement;
      const iconEye = toggleBtn.querySelector('.icon-eye') as HTMLElement;
      const iconEyeOff = toggleBtn.querySelector('.icon-eye-off') as HTMLElement;

      toggleBtn.addEventListener('click', () => {
        const oculta = input.type === 'password';
        input.type = oculta ? 'text' : 'password';
        iconEye.style.display = oculta ? 'none' : 'block';
        iconEyeOff.style.display = oculta ? 'block' : 'none';
        toggleBtn.setAttribute('aria-label', oculta ? 'Ocultar contraseña' : 'Mostrar contraseña');
      });
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    background: #0d0d0e;
  }
</style>

<style>
  .login-wrap {
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: 'Inter', system-ui, sans-serif;
    padding: 1.25rem;
  }

  .login-card {
    background: #18171a;
    border: 1px solid #2a282d;
    border-radius: 14px;
    padding: 2rem;
    width: min(360px, 100%);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
  }

  .login-brand {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: #f2ede7;
  }

  .login-brand span {
    color: #a67c52;
  }

  .login-sub {
    color: #9a938c;
    font-size: 0.85rem;
    margin: -0.5rem 0 0;
  }

  .login-label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: #9a938c;
  }

  .login-label input {
    background: #0f0e10;
    border: 1px solid #2a282d;
    border-radius: 8px;
    padding: 0.65rem 0.75rem;
    color: #f2ede7;
    font-family: inherit;
    font-size: 1rem;
    width: 100%;
    box-sizing: border-box;
  }

  .login-label input:focus {
    outline: 2px solid #a67c52;
    outline-offset: 1px;
  }

  .login-password-wrap {
    position: relative;
    display: flex;
  }

  .login-password-wrap input {
    padding-right: 2.5rem;
  }

  .login-toggle-eye {
    position: absolute;
    right: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #9a938c;
    cursor: pointer;
    padding: 0.2rem;
    display: flex;
  }

  .login-toggle-eye:hover {
    color: #f2ede7;
  }

  .login-btn {
    margin-top: 0.4rem;
    background: #a67c52;
    color: #17130f;
    border: none;
    padding: 0.8rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .login-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(166, 124, 82, 0.35);
  }

  .login-error {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(138, 106, 99, 0.15);
    color: #e2a49b;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    font-size: 0.82rem;
    margin: 0;
  }

  @media (max-width: 400px) {
    .login-card {
      padding: 1.5rem;
    }
  }
</style>