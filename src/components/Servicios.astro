---
import '../styles/servicios.css'
import Serv1 from '../assets/preciosnuevos1.jpeg'
import Serv1b from '../assets/preciosnuevos1b.jpeg'
import Serv1c from '../assets/preciosnuevos1c.jpeg'
import Serv2 from '../assets/cejas.jpeg'
import Serv3 from '../assets/unas-precios.webp'
---

<section class="servicios" id="servicios">
    <div class="serv-txt">
        <h2>Los Servicios <br> que ofrece <span style="color:#a67c52;font-size:32px;">favlash</span></h2>
    </div>
    
    <div class="serv-grid">
      <div class="sgrid-3">
            <h3>Extensiones de pestañas </h3>
            <p>Amplifica tu mirada con extensiones de pestañas de alta calidad para un volumen y longitud impactantes.</p>
            <div class="btns1">
                <button onclick="abrirModal3('Extensiones de pestañas')" class="citas-3">Ver precios</button>
            </div>
            

            <!-- Modal -->
            <div id="modal-esp-3" class="modal-esp-3">
                <div class="modal-content-esp-3">
                  <span class="cerrar-esp-3" onclick="cerrarModal3()">&times;</span>
                  <h2 id="titulo-modal-esp-3"></h2>

                  <div class="modal-tabs">
                    <div class="modal-tabs-nav">
                      <button class="modal-tab-btn active" id="tab-btn-0" onclick="goToTab3(0)">1</button>
                      <button class="modal-tab-btn" id="tab-btn-1" onclick="goToTab3(1)">2</button>
                      <button class="modal-tab-btn" id="tab-btn-2" onclick="goToTab3(2)">3</button>
                    </div>

                    <div class="modal-tab-panel active" id="tab-panel-0">
                      <img src={Serv1.src} alt="precios-pestañas-lista-1" />
                    </div>
                    <div class="modal-tab-panel" id="tab-panel-1">
                      <img src={Serv1b.src} alt="precios-pestañas-lista-2" />
                    </div>
                    <div class="modal-tab-panel" id="tab-panel-2">
                      <img src={Serv1c.src} alt="precios-pestañas-lista-3" />
                    </div>
                  </div>

                </div>
              </div>
                 <!-- Modal -->
        </div>

          <div class="sgrid-2">
            <h3>Estilismo De Cejas</h3>
            <p>Consigue el estilo perfecto. Peinados que destacan tu esencia, desde lo clásico hasta lo más moderno.</p>
            <div class="btns1">
                <button onclick="abrirModal2('Estilismo De Cejas')" class="citas-2">Ver precios</button>
            </div>
            

            <!-- Modal -->
            <div id="modal-esp-2" class="modal-esp-2">
                <div class="modal-content-esp-2">
                  <span class="cerrar-esp-2" onclick="cerrarModal2()">&times;</span>
                  <h2 id="titulo-modal-esp-2"></h2>
                  <div class="spantxt">
                    <img 
                    src={Serv2.src}
                    width="100%",
                    height="100%",
                    alt="precios-cejas"
                    />
                  </div>
                </div>
              </div>
                 <!-- Modal -->
        </div>

        <div class="sgrid-1">
            <h3>Maquillaje Profesional</h3>
            <p>Realza tu belleza con un look personalizado, desde natural a glamuroso, para cada ocasión especial.</p>
           <!--  <div class="btns1">
                <button onclick="abrirModal1('Maquillaje Profesional')" class="citas-1">Ver servicio</button>
            </div>-->
           

            <!-- Modal -->
            <div id="modal-esp-1" class="modal-esp-1">
                <div class="modal-content-esp-1">
                  <span class="cerrar-esp-1" onclick="cerrarModal1()">&times;</span>
                  <h2 id="titulo-modal-esp-1"></h2>
                  <div class="spantxt">
                    <span>desde:ooo</span>
                  </div>
                 
                </div>
              </div>
                 <!-- Modal -->
        </div>
      
        
        <div class="sgrid-4">
            <h3>servicio de manicura y pedicura</h3>
            <p>Consentimos tus manos y pies con técnicas impecables y realizados con herramientas previamente desinfectadas y esterilizadas para tu protección.</p>
             <div class="btns1">
                <button onclick="abrirModal4('servicio de manicura')" class="citas-4">Ver precios</button>
            </div>
            

                  <!-- Modal -->
            <div id="modal-esp-4" class="modal-esp-4">
                <div class="modal-content-esp-4">
                  <span class="cerrar-esp-4" onclick="cerrarModal4()">&times;</span>
                  <h2 id="titulo-modal-esp-4"></h2>
                  <div class="spantxt">
                   <img 
                   src={Serv3.src}
                   width="90%",
                   height="90%",
                   alt="precios-pestañas"
                   />
                  </div>
                </div>
              </div>
                 <!-- Modal -->
        </div>
    </div>
</section>

<script is:inline>
    function abrirModal1(titulo) {
  document.getElementById("titulo-modal-esp-1").innerText = titulo;
  document.getElementById("modal-esp-1").style.display = "block";
}
function cerrarModal1() {
  document.getElementById("modal-esp-1").style.display = "none";
}

function abrirModal2(titulo) {
  document.getElementById("titulo-modal-esp-2").innerText = titulo;
  document.getElementById("modal-esp-2").style.display = "block";
}
function cerrarModal2() {
  document.getElementById("modal-esp-2").style.display = "none";
}

function abrirModal3(titulo) {
  document.getElementById("titulo-modal-esp-3").innerText = titulo;
  document.getElementById("modal-esp-3").style.display = "block";
  goToTab3(0); // Reinicia el tab activo al abrir
}
function cerrarModal3() {
  document.getElementById("modal-esp-3").style.display = "none";
}

function abrirModal4(titulo) {
  document.getElementById("titulo-modal-esp-4").innerText = titulo;
  document.getElementById("modal-esp-4").style.display = "block";
}
function cerrarModal4() {
  document.getElementById("modal-esp-4").style.display = "none";
}

  // Cierre al hacer clic fuera del contenido
  window.addEventListener('click', function (e) {
    const modals = document.querySelectorAll('[id^="modal-esp-"]');
    modals.forEach((modal) => {
      if (modal.style.display === 'block' && e.target === modal) {
        modal.style.display = 'none';
      }
    });
  });

  // ------- Tabs modal 3 (Extensiones de pestañas) -------
  function goToTab3(index) {
    const panels = document.querySelectorAll('#modal-esp-3 .modal-tab-panel');
    const buttons = document.querySelectorAll('#modal-esp-3 .modal-tab-btn');

    panels.forEach((panel, i) => {
      panel.classList.toggle('active', i === index);
    });
    buttons.forEach((btn, i) => {
      btn.classList.toggle('active', i === index);
    });
  }
</script>