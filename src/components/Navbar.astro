---
import '../styles/navbar.css';
import ImageLogo from '../assets/favlash-horizonta-2.jpg';

// El UTM permite ver en Analytics cuántas personas llegan al Club desde el navbar.
const CLUB_URL = 'https://club.favlash.com/?utm_source=favlash.com&utm_medium=navbar&utm_campaign=club';
const CITA_URL = '#agenda-tu-cita';

const links = [
  { href: '#nosotras', label: 'Nosotras' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#testimonios', label: 'Testimonios' },
];
---

<a class="fl-skip" href="#main">Saltar al contenido</a>

<!-- Barra de contacto: se va con el scroll (solo escritorio) -->
<div class="fl-topbar">
  <div class="fl-topbar__in">
    <div class="fl-topbar__contact">
      <a href="mailto:sundae.hq@gmail.com"><i class="bi bi-envelope-paper-heart-fill" aria-hidden="true"></i> sundae.hq@gmail.com</a>
      <a href="tel:+526631208318"><i class="bi bi-telephone-inbound-fill" aria-hidden="true"></i> (663) 120-8318</a>
    </div>
    <div class="fl-topbar__social">
      <span>Síguenos:</span>
      <a href="https://www.facebook.com/favlash.sandyh" target="_blank" rel="noopener" aria-label="Facebook"><i class="bi bi-facebook" aria-hidden="true"></i></a>
      <a href="https://www.instagram.com/favlash.sandyh/" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram" aria-hidden="true"></i></a>
      <a href="https://www.tiktok.com/@favlash" target="_blank" rel="noopener" aria-label="TikTok"><i class="bi bi-tiktok" aria-hidden="true"></i></a>
      <a href="https://wa.link/n1xc24" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="bi bi-whatsapp" aria-hidden="true"></i></a>
    </div>
  </div>
</div>

<!-- Centinela: cuando sale de la pantalla, el header se compacta (sin listeners de scroll) -->
<div id="flSentinel" aria-hidden="true"></div>

<header class="fl-header" id="flHeader">
  <nav class="fl-nav" aria-label="Principal">
    <a class="fl-logo" href="/" aria-label="FavLash, inicio">
      <img src={ImageLogo.src} width={ImageLogo.width} height={ImageLogo.height} alt="FavLash" />
    </a>

    <ul class="fl-links">
      {links.map((l) => (
        <li><a href={l.href} data-spy>{l.label}</a></li>
      ))}
    </ul>

    <div class="fl-actions">
      <a class="fl-btn fl-btn--club" href={CLUB_URL}>
        <i class="bi bi-stars" aria-hidden="true"></i> Club FavLash
      </a>
      <a class="fl-btn fl-btn--primary" href={CITA_URL}>Agenda tu cita</a>
    </div>

    <button class="fl-burger" id="flBurger" type="button" aria-expanded="false" aria-controls="flMenu" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <div class="fl-menu" id="flMenu">
    <div class="fl-menu__in">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} data-spy>{l.label}</a></li>
        ))}
      </ul>
      <div class="fl-menu__cta">
        <a class="fl-btn fl-btn--club" href={CLUB_URL}><i class="bi bi-stars" aria-hidden="true"></i> Club FavLash</a>
        <a class="fl-btn fl-btn--primary" href={CITA_URL}>Agenda tu cita</a>
      </div>
    </div>
  </div>
</header>

<script>
  import '../scripts/menu.js';
</script>