---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { r, UI, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
  crumbs?: { label: string; href?: string }[];
  eyebrow: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  stats?: { n: string; l: string }[];
}
const { lang, crumbs = [], eyebrow, lead, image, imageAlt = '', stats = [] } = Astro.props;
const all = [{ label: UI[lang].home, href: r('home', lang) }, ...crumbs];
---

<section class="phero">
  <div class="wrap">
    <nav aria-label={lang === 'es' ? 'Migas de pan' : 'Breadcrumb'}>
      <ol class="crumbs">
        {all.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol>
    </nav>
    <div class="phero__grid">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="d-l"><slot /></h1>
        {lead && <p class="lead">{lead}</p>}
        <slot name="actions" />
        {stats.length > 0 && (
          <div class="phero__stats">
            {stats.map((s) => <div><strong>{s.n}</strong><span>{s.l}</span></div>)}
          </div>
        )}
      </div>
      {image && (
        <div class="phero__media" data-reveal>
          <Image src={image} alt={imageAlt} widths={[480, 760]} sizes="(min-width: 960px) 34vw, 100vw" loading="eager" />
        </div>
      )}
    </div>
  </div>
</section>
