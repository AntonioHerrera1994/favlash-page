---
import { Image, getImage } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Visit from '../components/site/Visit.astro';
import { GALERIA } from '../data/contenido';
import { SITE } from '../config/site';
import { r, UI, type Lang } from '../i18n/routes';
import { breadcrumbLd } from '../lib/seo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const t = UI[lang];
const items = await Promise.all(GALERIA.map(async (g) => ({ ...g, full: (await getImage({ src: g.img, width: 1200, format: 'webp' })).src })));
const title = es ? 'Galería: Pestañas y Cejas en Tijuana | FavLash' : 'Gallery: Lash & Brow Work in Tijuana | FavLash';
const description = es
  ? 'Trabajos reales de FavLash en Tijuana: extensiones de pestañas, Water Brows, laminado de cejas y Organic Brows.'
  : 'Real work from FavLash in Tijuana, near San Diego: lash extensions, Water Brows, brow lamination and Organic Brows.';
const jsonld = [breadcrumbLd([{ name: t.home, path: r('home', lang) }, { name: t.nav.galeria, path: r('galeria', lang) }])];
---

<SiteLayout lang={lang} page="galeria" title={title} description={description} jsonld={jsonld}>
  <PageHero lang={lang} crumbs={[{ label: t.nav.galeria }]} eyebrow={es ? 'Galería' : 'Gallery'}
    lead={es ? 'Trabajos reales del estudio. Toca una foto para verla en grande.' : 'Real work from our studio. Tap a photo to view it larger.'}>
    {es ? <>Nuestro <span class="gold">trabajo</span></> : <>Our <span class="gold">work</span></>}
    <div slot="actions" class="btn-row"><a class="btn btn--ghost" href={SITE.social.instagram} target="_blank" rel="noopener"><i class="bi bi-instagram"></i>@favlash.sandyh</a></div>
  </PageHero>

  <section class="sec">
    <div class="wrap">
      <div class="filters" data-filter-for="gal" role="group" aria-label={es ? 'Filtrar' : 'Filter'}>
        <button type="button" data-f="all" aria-pressed="true">{es ? 'Todo' : 'All'}</button>
        <button type="button" data-f="pestanas" aria-pressed="false">{es ? 'Pestañas' : 'Lashes'}</button>
        <button type="button" data-f="cejas" aria-pressed="false">{es ? 'Cejas' : 'Brows'}</button>
      </div>
      <div class="masonry" id="gal" data-gallery>
        {items.map((g) => (
          <figure data-cat={g.cat.join(' ')} data-full={g.full}>
            <Image src={g.img} alt={`${g.title[lang]} — FavLash Tijuana`} widths={[400, 640]} sizes="(min-width: 1000px) 33vw, (min-width: 600px) 50vw, 100vw" />
            <figcaption>{g.title[lang]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <dialog class="lb" id="lb" slot="end" aria-label={es ? 'Visor de imagen' : 'Image viewer'}>
    <button class="lb__x" type="button" aria-label={t.close}>✕</button>
    <button class="lb__nav lb__prev" type="button" aria-label={es ? 'Anterior' : 'Previous'}><i class="bi bi-chevron-left"></i></button>
    <img alt="" />
    <p></p>
    <button class="lb__nav lb__next" type="button" aria-label={es ? 'Siguiente' : 'Next'}><i class="bi bi-chevron-right"></i></button>
  </dialog>

  <Visit lang={lang} />
</SiteLayout>
